# Optional machine-local cache locations generated by
# `bin/dot setup --cache-workspace WORKSPACE`.
dotfiles_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
if [[ "$dotfiles_config_home" != /* ]]
then
	dotfiles_config_home="$HOME/.config"
fi
dotfiles_cache_root="$dotfiles_config_home/dotfiles"
dotfiles_cache_versions="$dotfiles_cache_root/cache-env.d"
dotfiles_cache_env=''
dotfiles_cache_marker=''
dotfiles_cache_end=''
dotfiles_cache_latest=''
if [[ -d "$dotfiles_cache_versions" && ! -L "$dotfiles_cache_versions" ]]
then
	for dotfiles_cache_candidate in "$dotfiles_cache_versions"/v*.sh(N)
	do
		[[ ! -L "$dotfiles_cache_candidate" &&
		  -f "$dotfiles_cache_candidate" &&
		  -r "$dotfiles_cache_candidate" ]] || continue
		dotfiles_cache_name=${dotfiles_cache_candidate##*/}
		dotfiles_cache_digits=${dotfiles_cache_name#v}
		dotfiles_cache_digits=${dotfiles_cache_digits%.sh}
		[[ ${#dotfiles_cache_digits} -eq 18 &&
		  "$dotfiles_cache_digits" != *[!0-9]* ]] || continue
		dotfiles_cache_marker=''
		dotfiles_cache_end=''
		dotfiles_cache_line=''
		dotfiles_cache_first=true
		while IFS= read -r dotfiles_cache_line ||
		  [[ -n "$dotfiles_cache_line" ]]
		do
			if [[ "$dotfiles_cache_first" == "true" ]]
			then
				dotfiles_cache_marker=$dotfiles_cache_line
				dotfiles_cache_first=false
			fi
			dotfiles_cache_end=$dotfiles_cache_line
		done < "$dotfiles_cache_candidate"
		[[ "$dotfiles_cache_marker" ==
		  '# Managed by dotfiles script/cache-env.sh.' &&
		  "$dotfiles_cache_end" ==
		  '# End managed dotfiles cache environment.' ]] || continue
		if [[ -z "$dotfiles_cache_latest" ||
		  "$dotfiles_cache_name" > "$dotfiles_cache_latest" ]]
		then
			dotfiles_cache_latest=$dotfiles_cache_name
			dotfiles_cache_env=$dotfiles_cache_candidate
		fi
	done
fi

if [[ -z "$dotfiles_cache_env" ]]
then
	dotfiles_cache_env="$dotfiles_cache_root/cache-env.sh"
	if [[ -L "$dotfiles_cache_env" || ! -f "$dotfiles_cache_env" ||
	  ! -r "$dotfiles_cache_env" ]] ||
	  ! IFS= read -r dotfiles_cache_marker < "$dotfiles_cache_env" ||
	  [[ "$dotfiles_cache_marker" !=
	  '# Managed by dotfiles script/cache-env.sh.' ]]
	then
		dotfiles_cache_env=''
	fi
fi

if [[ -n "$dotfiles_cache_env" ]]
then
	source "$dotfiles_cache_env"
fi
unset dotfiles_config_home dotfiles_cache_root dotfiles_cache_versions
unset dotfiles_cache_env dotfiles_cache_marker dotfiles_cache_end
unset dotfiles_cache_latest dotfiles_cache_candidate dotfiles_cache_line
unset dotfiles_cache_first dotfiles_cache_name dotfiles_cache_digits

[[ -s "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

export PATH="$HOME/.local/bin:$PATH"
