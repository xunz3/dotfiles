# Optional machine-local cache locations generated by
# `bin/dot setup --cache-workspace WORKSPACE`.
dotfiles_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
if [[ "$dotfiles_config_home" != /* ]]
then
	dotfiles_config_home="$HOME/.config"
fi
dotfiles_cache_root="$dotfiles_config_home/dotfiles"
dotfiles_cache_helper="${${(%):-%N}:A:h:h}/script/lib/cache-profile.sh"
if [[ -r "$dotfiles_cache_helper" ]]
then
	source "$dotfiles_cache_helper"
	if dotfiles_cache_select_profile "$dotfiles_cache_root"
	then
		source "$DOTFILES_CACHE_PROFILE"
	fi
	unfunction dotfiles_cache_profile_is_complete \
		dotfiles_cache_find_latest_version dotfiles_cache_select_profile 2>/dev/null
	unset DOTFILES_CACHE_MANAGED_MARKER DOTFILES_CACHE_MANAGED_END_MARKER
	unset DOTFILES_CACHE_PROFILE
fi
unset dotfiles_config_home dotfiles_cache_root dotfiles_cache_helper

[[ -s "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

export PATH="$HOME/.local/bin:$PATH"
