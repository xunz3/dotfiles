# dotfiles root; keep this separate from oh-my-zsh's $ZSH variable.
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
export ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH/custom}"
export ZSH_THEME="${ZSH_THEME:-lambda}"
export ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh}"
export ZSH_COMPDUMP="${ZSH_COMPDUMP:-$ZSH_CACHE_DIR/.zcompdump-$HOST-$ZSH_VERSION}"

# your project folder that we can `c [tab]` to
if [[ -z "${PROJECTS:-}" ]]
then
  if [[ -d "$HOME/projects" ]]
  then
    export PROJECTS="$HOME/projects"
  elif [[ -d "$HOME/Code" ]]
  then
    export PROJECTS="$HOME/Code"
  else
    export PROJECTS="$HOME/projects"
  fi
fi

# Interactive aliases and shell hooks live in ~/.localrc. Variables needed by
# scripts and non-interactive shells belong in ~/.localenv (loaded by .zshenv).
if [[ -r "$HOME/.localrc" ]]
then
  source "$HOME/.localrc"
fi

# all shell modules
typeset -U config_files
config_files=(
  $DOTFILES/shell/**/*.zsh(N)
  $DOTFILES/zsh/**/*.zsh(N)
)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load the completion prerequisites before compinit or oh-my-zsh.
for file in ${(M)config_files:#*/fpath.zsh}
do
  source $file
done

for file in ${(M)config_files:#*/config.zsh}
do
  source $file
done

if [[ "${DOTFILES_USE_OH_MY_ZSH:-1}" == "1" && -s "$ZSH/oh-my-zsh.sh" ]]
then
  # Keep expensive language runtimes out of the shell startup path.
  zstyle ':omz:plugins:nvm' lazy yes

  # fzf 0.44+ supports these portable UI options. Respect machine-local
  # overrides when a different layout is preferred.
  export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:---height=60% --layout=reverse --border=rounded --info=inline}"

  plugins=(git)
  if [[ -t 0 && -t 1 ]] && (( $+commands[fzf] ))
  then
    plugins+=(fzf)
  fi
  # zoxide owns `z` when installed. Keep Oh My Zsh's z plugin as a fallback on
  # minimal hosts where only the linked configuration has been bootstrapped.
  if ! (( $+commands[zoxide] ))
  then
    plugins+=(z)
  fi
  plugins+=(gh nvm zsh-autosuggestions)

  source "$ZSH/oh-my-zsh.sh"
else
  mkdir -p "$ZSH_CACHE_DIR/completions" 2>/dev/null
  autoload -U compinit
  compinit -d "$ZSH_COMPDUMP"
fi

# load everything but the path, completion, and pre-compinit files
for file in ${${${config_files:#*/path.zsh}:#*/fpath.zsh}:#*/config.zsh}
do
  if [[ "$file" == */prompt.zsh && "${DOTFILES_USE_CUSTOM_PROMPT:-0}" != "1" ]]
  then
    continue
  fi
  [[ "$file" == */completion.zsh ]] && continue
  source $file
done

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

# Better history
# Credits to https://coderwall.com/p/jpj_6q/zsh-better-history-searching-with-arrow-keys
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search # Up
bindkey "^[[B" down-line-or-beginning-search # Down

# direnv deliberately requires `direnv allow` before executing a project's
# .envrc. Install its prompt hook late so it observes the final prompt state.
if (( $+commands[direnv] ))
then
  eval "$(direnv hook zsh)"
fi

# zoxide must initialize after compinit for its interactive Zsh completions.
# It intentionally replaces the older `z` implementation, not the cd builtin.
if (( $+commands[zoxide] ))
then
  eval "$(zoxide init zsh)"
fi

# zsh-syntax-highlighting must be loaded after compinit, plugins, widgets, and
# every bindkey call so its ZLE hook sees the final line-editor configuration.
syntax_highlighting="$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
if [[ -r "$syntax_highlighting" ]]
then
  source "$syntax_highlighting"
fi
unset syntax_highlighting
