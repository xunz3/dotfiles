" Lightweight terminal Vim configuration. Keep IDE features in VS Code.
set nocompatible
scriptencoding utf-8

filetype plugin indent on
syntax enable

" Editing defaults
set encoding=utf-8
set backspace=indent,eol,start
set hidden
set confirm
set autoread
set mouse=a

set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set autoindent
set smartindent

" Search and navigation
set number
set ruler
set showcmd
set showmatch
set scrolloff=3
set sidescrolloff=5
set nowrap
set incsearch
set hlsearch
set ignorecase
set smartcase

" Completion and display
set wildmenu
set wildmode=longest:full,full
set laststatus=2
set background=dark
colorscheme desert

if has('clipboard')
  set clipboard^=unnamedplus
endif

let mapleader = ' '
nnoremap <silent> <leader>w :write<CR>
nnoremap <silent> <leader>q :quit<CR>
nnoremap <silent> <Esc><Esc> :nohlsearch<CR>

augroup dotfiles_vim
  autocmd!
  autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line('$') | execute "normal! g`\"" | endif
  autocmd FileType gitcommit,markdown,text setlocal wrap linebreak
  autocmd FileType make setlocal noexpandtab
augroup END
