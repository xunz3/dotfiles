#!/usr/bin/env bash
#
# Run package installation and topic installers.

set -euo pipefail

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)
print_only=false
install_toolchains="${DOTFILES_INSTALL_TOOLCHAINS:-0}"
skip_packages=0

info () {
	printf "\r  [ \033[00;34m..\033[0m ] %s\n" "$1"
}

success () {
	printf "\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n" "$1"
}

fail () {
	printf "\r\033[2K  [\033[0;31mFAIL\033[0m] %s\n" "$1" >&2
	exit 1
}

usage () {
	cat <<'EOF'
Usage: script/install [options]

Options:
  --print, --list   print the package list for the current machine
  --user           skip system package installation
  --toolchains     include toolchain package lists and toolchain installers
  -h, --help        show this help text
EOF
}

have_command () {
	command -v "$1" >/dev/null 2>&1
}

run_as_root () {
	if [[ "${EUID}" -eq 0 ]]
	then
		"$@"
	else
		sudo "$@"
	fi
}

read_package_file () {
	local package_file=$1

	if [[ ! -f "$package_file" ]]
	then
		return
	fi

	grep -vE '^\s*#|^\s*$' "$package_file"
}

detect_package_manager () {
	if have_command apt-get
	then
		printf 'apt'
	elif have_command dnf
	then
		printf 'dnf'
	elif have_command pacman
	then
		printf 'pacman'
	elif have_command zypper
	then
		printf 'zypper'
	else
		return 1
	fi
}

resolve_packages () {
	local manager=$1

	{
		read_package_file "$DOTFILES_ROOT/packages/common.txt"
		read_package_file "$DOTFILES_ROOT/packages/${manager}.txt"
		if [[ "$install_toolchains" == "1" ]]
		then
			read_package_file "$DOTFILES_ROOT/packages/common-toolchains.txt"
			read_package_file "$DOTFILES_ROOT/packages/${manager}-toolchains.txt"
		fi
	} | awk '!seen[$0]++'
}

print_packages () {
	local manager=$1
	shift

	local profile='base'
	if [[ "$install_toolchains" == "1" ]]
	then
		profile='toolchains'
	fi

	printf 'package manager: %s\n' "$manager"
	printf 'profile: %s\n' "$profile"

	if [[ $# -eq 0 ]]
	then
		printf '(no packages configured)\n'
		return
	fi

	printf '%s\n' "$@"
}

install_linux_packages () {
	local manager=''
	if ! manager="$(detect_package_manager)"
	then
		fail 'no supported package manager found (apt-get, dnf, pacman, zypper)'
	fi

	mapfile -t packages < <(resolve_packages "$manager")

	if [[ "$print_only" == "true" ]]
	then
		print_packages "$manager" "${packages[@]}"
		return
	fi

	if [[ "$skip_packages" == "1" ]]
	then
		info 'skipping package installation for user-only mode'
		return
	fi

	if [[ ${#packages[@]} -eq 0 ]]
	then
		info "no packages listed for $manager"
		return
	fi

	info "installing packages with $manager"
	case "$manager" in
		apt)
			run_as_root apt-get update
			run_as_root apt-get install -y "${packages[@]}"
			;;
		dnf)
			run_as_root dnf install -y "${packages[@]}"
			;;
		pacman)
			run_as_root pacman -S --needed --noconfirm "${packages[@]}"
			;;
		zypper)
			run_as_root zypper --non-interactive install "${packages[@]}"
			;;
	esac
	success "$manager packages installed"
}

run_topic_installer () {
	local installer=$1
	local label="${installer#"$DOTFILES_ROOT/"}"

	info "running $label"
	if "$installer"
	then
		return 0
	fi

	info "$label failed; continuing with remaining installers"
}

is_ordered_topic_installer () {
	case "${1#"$DOTFILES_ROOT/"}" in
		ssh/install.sh|zsh/install.sh|vim/install.sh|nvim/install.sh|toolchains/install.sh)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

run_topic_installers () {
	local installer topic

	export DOTFILES_INSTALL_TOOLCHAINS="$install_toolchains"

	for topic in ssh zsh vim nvim toolchains
	do
		installer="$DOTFILES_ROOT/$topic/install.sh"
		[[ -f "$installer" ]] && run_topic_installer "$installer"
	done

	while IFS= read -r -d '' installer
	do
		is_ordered_topic_installer "$installer" && continue
		run_topic_installer "$installer"
	done < <(find "$DOTFILES_ROOT" -mindepth 2 -maxdepth 2 -name install.sh -print0 | sort -z)
}

while [[ $# -gt 0 ]]
do
	case "$1" in
		--print|--list)
			print_only=true
			;;
		--user)
			skip_packages=1
			;;
		--toolchains)
			install_toolchains=1
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			fail "unknown option: $1"
			;;
	esac
	shift
done

case "$(uname -s)" in
	Linux)
		install_linux_packages
		;;
	*)
		fail "unsupported operating system: $(uname -s) (this repo is Linux-only)"
		;;
esac

if [[ "$print_only" == "true" ]]
then
	exit 0
fi

run_topic_installers
