#!/usr/bin/env bash
#
# Run package installation and topic installers.

set -euo pipefail

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)
print_only=false
install_toolchains=0
skip_packages=0
cache_workspace=''
toolchain_profiles=()
resolved_toolchain_profiles=()
package_manager=''
package_total=0
failed_packages=()
succeeded_topics=()
failed_topics=()

info () {
	printf "\r  [ \033[00;34m..\033[0m ] %s\n" "$1"
}

success () {
	printf "\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n" "$1"
}

fail () {
	printf "\r\033[2K  [\033[0;31mFAIL\033[0m] %s\n" "$1" >&2
	exit 1
}

usage () {
	cat <<'EOF'
Usage: script/install [options]

Options:
  --print          print the package list for the current machine
  --user           skip system package installation
  --cache-workspace DIR
                   configure centralized caches under DIR/cache
  --toolchains     include selected toolchain package lists and installers
  -h, --help        show this help text

Toolchain profiles may follow --toolchains, for example:
  script/install --toolchains node java
EOF
}

have_command () {
	command -v "$1" >/dev/null 2>&1
}

load_cache_environment () {
	local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
	local cache_env_file=''
	local cache_env_root cache_env_versions
	local candidate candidate_name version_digits latest_name=''
	local cache_env_marker='' cache_env_end='' line='' first_line=false

	if [[ "$config_home" != /* ]]
	then
		config_home="$HOME/.config"
	fi
	cache_env_root="$config_home/dotfiles"
	cache_env_versions="$cache_env_root/cache-env.d"

	if [[ -d "$cache_env_versions" && ! -L "$cache_env_versions" ]]
	then
		for candidate in "$cache_env_versions"/v*.sh
		do
			[[ -e "$candidate" && ! -L "$candidate" && -f "$candidate" &&
				-r "$candidate" ]] || continue
			candidate_name=${candidate##*/}
			version_digits=${candidate_name#v}
			version_digits=${version_digits%.sh}
			[[ ${#version_digits} -eq 18 &&
				"$version_digits" != *[!0-9]* ]] || continue
			cache_env_marker=''
			cache_env_end=''
			line=''
			first_line=true
			while IFS= read -r line || [[ -n "$line" ]]
			do
				if [[ "$first_line" == "true" ]]
				then
					cache_env_marker=$line
					first_line=false
				fi
				cache_env_end=$line
			done < "$candidate"
			[[ "$cache_env_marker" == '# Managed by dotfiles script/cache-env.sh.' &&
				"$cache_env_end" == '# End managed dotfiles cache environment.' ]] ||
				continue
			if [[ -z "$latest_name" || "$candidate_name" > "$latest_name" ]]
			then
				latest_name=$candidate_name
				cache_env_file=$candidate
			fi
		done
	fi

	if [[ -z "$cache_env_file" ]]
	then
		cache_env_file="$cache_env_root/cache-env.sh"
		if [[ -L "$cache_env_file" || ! -f "$cache_env_file" ||
			! -r "$cache_env_file" ]] ||
			! IFS= read -r cache_env_marker < "$cache_env_file" ||
			[[ "$cache_env_marker" != '# Managed by dotfiles script/cache-env.sh.' ]]
		then
			return
		fi
	fi

	# shellcheck source=/dev/null
	source "$cache_env_file"
}

run_as_root () {
	if [[ "${EUID}" -eq 0 ]]
	then
		"$@"
	else
		sudo "$@"
	fi
}

read_package_file () {
	local package_file=$1

	if [[ ! -f "$package_file" ]]
	then
		return
	fi

	grep -vE '^\s*#|^\s*$' "$package_file"
}

detect_package_manager () {
	if have_command apt-get
	then
		printf 'apt'
	elif have_command dnf
	then
		printf 'dnf'
	elif have_command pacman
	then
		printf 'pacman'
	elif have_command zypper
	then
		printf 'zypper'
	else
		return 1
	fi
}

resolve_packages () {
	local manager=$1
	local profile

	{
		read_package_file "$DOTFILES_ROOT/packages/common.txt"
		read_package_file "$DOTFILES_ROOT/packages/${manager}.txt"
		if [[ "$install_toolchains" == "1" ]]
		then
			for profile in "${resolved_toolchain_profiles[@]}"
			do
				read_package_file "$DOTFILES_ROOT/toolchains/packages/common/${profile}.txt"
				read_package_file "$DOTFILES_ROOT/toolchains/packages/${manager}/${profile}.txt"
			done
		fi
	} | awk '!seen[$0]++'
}

print_packages () {
	local manager=$1
	shift

	local profile='base'
	if [[ "$install_toolchains" == "1" ]]
	then
		profile="toolchains:${resolved_toolchain_profiles[*]:-none}"
	fi

	printf 'package manager: %s\n' "$manager"
	printf 'profile: %s\n' "$profile"

	if [[ $# -eq 0 ]]
	then
		printf '(no packages configured)\n'
		return
	fi

	printf '%s\n' "$@"
}

install_linux_packages () {
	local manager=''
	local -a packages

	if [[ "$skip_packages" == "1" ]]
	then
		if [[ "$print_only" == "true" ]]
		then
			printf 'package manager: skipped\n'
			printf 'profile: user-only\n'
			printf '(system packages skipped)\n'
		else
			info 'skipping package installation for user-only mode'
		fi
		return 0
	fi

	if ! manager="$(detect_package_manager)"
	then
		fail 'no supported package manager found (apt-get, dnf, pacman, zypper)'
	fi
	package_manager="$manager"

	mapfile -t packages < <(resolve_packages "$manager")
	package_total=${#packages[@]}

	if [[ "$print_only" == "true" ]]
	then
		print_packages "$manager" "${packages[@]}"
		return
	fi

	if [[ ${#packages[@]} -eq 0 ]]
	then
		info "no packages listed for $manager"
		return
	fi

	info "installing packages with $manager"
	if [[ "$manager" == "apt" ]]
	then
		if ! run_as_root apt-get update
		then
			info 'apt package metadata update failed; continuing with existing metadata'
		fi
	fi

	if install_package_batch "$manager" "${packages[@]}"
	then
		success "$manager packages installed"
		return
	fi

	info 'bulk package installation failed; retrying one package at a time'
	if retry_packages_individually "$manager" "${packages[@]}"
	then
		return 0
	fi

	return 1
}

install_package_batch () {
	local manager=$1
	shift

	case "$manager" in
		apt)
			run_as_root apt-get install -y "$@"
			;;
		dnf)
			run_as_root dnf install -y "$@"
			;;
		pacman)
			run_as_root pacman -S --needed --noconfirm "$@"
			;;
		zypper)
			run_as_root zypper --non-interactive install "$@"
			;;
	esac
}

install_one_package () {
	local manager=$1
	local package=$2

	case "$manager" in
		apt)
			run_as_root apt-get install -y "$package"
			;;
		dnf)
			run_as_root dnf install -y "$package"
			;;
		pacman)
			run_as_root pacman -S --needed --noconfirm "$package"
			;;
		zypper)
			run_as_root zypper --non-interactive install "$package"
			;;
	esac
}

retry_packages_individually () {
	local manager=$1
	shift
	local package
	local failed=()

	for package in "$@"
	do
		if install_one_package "$manager" "$package"
		then
			continue
		fi

		failed+=("$package")
	done

	if [[ ${#failed[@]} -eq 0 ]]
	then
		success "$manager packages installed"
		return
	fi

	info "packages not installed: ${failed[*]}"
	info 'continuing with topic installers'
	failed_packages+=("${failed[@]}")
	return 1
}

run_topic_installer () {
	local installer=$1
	shift
	local label="${installer#"$DOTFILES_ROOT/"}"

	info "running $label"
	if "$installer" "$@"
	then
		return 0
	fi

	info "$label failed; continuing with remaining installers"
	return 1
}

record_topic_installer () {
	local installer=$1
	shift
	local label="${installer#"$DOTFILES_ROOT/"}"

	if run_topic_installer "$installer" "$@"
	then
		succeeded_topics+=("$label")
	else
		failed_topics+=("$label")
	fi
}

is_ordered_topic_installer () {
	case "${1#"$DOTFILES_ROOT/"}" in
		ssh/install.sh|zsh/install.sh|vim/install.sh|nvim/install.sh|toolchains/install.sh)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

run_topic_installers () {
	local installer topic

	for topic in ssh zsh vim nvim
	do
		installer="$DOTFILES_ROOT/$topic/install.sh"
		if [[ -f "$installer" ]]
		then
			record_topic_installer "$installer"
		fi
	done

	if [[ "$install_toolchains" == "1" ]]
	then
		installer="$DOTFILES_ROOT/toolchains/install.sh"
		if [[ -f "$installer" ]]
		then
			record_topic_installer "$installer" "${resolved_toolchain_profiles[@]}"
		fi
	fi

	while IFS= read -r -d '' installer
	do
		is_ordered_topic_installer "$installer" && continue
		record_topic_installer "$installer"
	done < <(find "$DOTFILES_ROOT" -mindepth 2 -maxdepth 2 -name install.sh -print0 | sort -z)

	[[ ${#failed_topics[@]} -eq 0 ]]
}

print_install_summary () {
	local package_succeeded=$((package_total - ${#failed_packages[@]}))
	local item

	printf '\nInstallation summary\n'
	if [[ "$skip_packages" == "1" ]]
	then
		printf '  packages: skipped (user-only mode)\n'
	else
		printf '  packages: %d succeeded, %d failed (%s)\n' \
			"$package_succeeded" "${#failed_packages[@]}" "${package_manager:-unknown}"
	fi
	printf '  topics:   %d succeeded, %d failed\n' "${#succeeded_topics[@]}" "${#failed_topics[@]}"

	if [[ ${#failed_packages[@]} -eq 0 && ${#failed_topics[@]} -eq 0 ]]
	then
		return
	fi

	printf '\nFailed:\n'
	for item in "${failed_packages[@]}"
	do
		printf '  package: %s\n' "$item"
	done
	for item in "${failed_topics[@]}"
	do
		printf '  topic: %s\n' "$item"
	done
}

while [[ $# -gt 0 ]]
do
	case "$1" in
		--print)
			print_only=true
			;;
		--user)
			skip_packages=1
			;;
		--cache-workspace)
			if [[ $# -lt 2 || -z "${2:-}" || "$2" != /* ]]
			then
				fail '--cache-workspace requires an absolute WORKSPACE path'
			fi
			cache_workspace=$2
			shift
			;;
		--toolchains)
			install_toolchains=1
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			if [[ "$install_toolchains" == "1" ]]
			then
				toolchain_profiles+=("$1")
			else
				fail "unknown option: $1"
			fi
			;;
	esac
	shift
done

if [[ "$print_only" == "true" && -n "$cache_workspace" ]]
then
	fail '--cache-workspace cannot be combined with --print'
fi

if [[ -n "$cache_workspace" ]]
then
	"$DOTFILES_ROOT/script/cache-env.sh" --validate "$cache_workspace"
	"$DOTFILES_ROOT/script/cache-env.sh" "$cache_workspace"
fi

if [[ "$print_only" != "true" ]]
then
	load_cache_environment
fi

if [[ "$install_toolchains" == "1" ]]
then
	# shellcheck source=toolchains/lib/profiles.sh
	source "$DOTFILES_ROOT/toolchains/lib/profiles.sh"
	if [[ -f "$HOME/.toolchainsrc" ]]
	then
		# shellcheck source=/dev/null
		source "$HOME/.toolchainsrc"
	fi
	mapfile -t resolved_toolchain_profiles < <(dotfiles_toolchain_resolve_profiles "${toolchain_profiles[@]}")
	for profile in "${resolved_toolchain_profiles[@]}"
	do
		if ! dotfiles_toolchain_profile_exists "$profile"
		then
			fail "unknown toolchain profile: $profile"
		fi
	done
fi

overall_status=0

case "$(uname -s)" in
	Linux)
		if ! install_linux_packages
		then
			overall_status=1
		fi
		;;
	*)
		fail "unsupported operating system: $(uname -s) (this repo is Linux-only)"
		;;
esac

if [[ "$print_only" == "true" ]]
then
	exit 0
fi

if ! run_topic_installers
then
	overall_status=1
fi

print_install_summary
exit "$overall_status"
