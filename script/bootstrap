#!/usr/bin/env bash
#
# bootstrap installs things.

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -euo pipefail

echo ''

info () {
  printf "\r  [ \033[00;34m..\033[0m ] $1\n"
}

user () {
  printf "\r  [ \033[0;33m??\033[0m ] $1\n"
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit 1
}

overwrite_all=false
backup_all=false
skip_all=false
skip_gitconfig=false

while [[ $# -gt 0 ]]
do
  case "$1" in
    -f|--force)
      overwrite_all=true
      ;;
    -b|--backup)
      backup_all=true
      ;;
    -s|--skip)
      skip_all=true
      ;;
    --skip-gitconfig)
      skip_gitconfig=true
      ;;
    -h|--help)
      cat <<'EOF'
Usage: script/bootstrap [options]

Options:
  -f, --force          overwrite existing files
  -b, --backup         back up existing files to *.backup
  -s, --skip           skip existing files
      --skip-gitconfig do not create ~/.gitconfig.local
  -h, --help           show this help text
EOF
      exit 0
      ;;
    *)
      fail "unknown option: $1"
      ;;
  esac
  shift
done

setup_gitconfig () {
  if [[ "$skip_gitconfig" == "true" ]]
  then
    info 'skipping gitconfig setup'
    return
  fi

  if [[ ! -f "$HOME/.gitconfig.local" ]]
  then
    info 'setup gitconfig'

    local git_authorname="${DOTFILES_GIT_AUTHORNAME:-}"
    local git_authoremail="${DOTFILES_GIT_AUTHOREMAIL:-}"
    local git_credential="${DOTFILES_GIT_CREDENTIAL_HELPER:-cache}"
    local template

    if [[ -z "$git_authorname" || -z "$git_authoremail" ]]
    then
      if [[ ! -t 0 ]]
      then
        info 'skipping gitconfig setup; set DOTFILES_GIT_AUTHORNAME and DOTFILES_GIT_AUTHOREMAIL or rerun interactively'
        return
      fi

      user ' - What is your github author name?'
      read -r -e git_authorname
      user ' - What is your github author email?'
      read -r -e git_authoremail
    fi

    if [[ -z "$git_authorname" || -z "$git_authoremail" ]]
    then
      info 'git author name or email was empty; skipping gitconfig setup'
      return
    fi

    template="$(< git/gitconfig.local.symlink.example)"
    template="${template//AUTHORNAME/$git_authorname}"
    template="${template//AUTHOREMAIL/$git_authoremail}"
    template="${template//GIT_CREDENTIAL_HELPER/$git_credential}"
    printf '%s\n' "$template" > "$HOME/.gitconfig.local"
    chmod 600 "$HOME/.gitconfig.local"

    success 'created ~/.gitconfig.local'
  fi
}

setup_local_template () {
  local example_file=$1
  local target_file=$2

  if [[ ! -f "$example_file" || -e "$target_file" ]]
  then
    return
  fi

  cp "$example_file" "$target_file"
  chmod 600 "$target_file"
  success "created ${target_file/#$HOME/~} from ${example_file#"$DOTFILES_ROOT"/}"
}

setup_local_files () {
  setup_local_template "$DOTFILES_ROOT/local/localrc.example" "$HOME/.localrc"
  setup_local_template "$DOTFILES_ROOT/local/toolchainsrc.example" "$HOME/.toolchainsrc"
}

setup_dotfiles_alias () {
  local target="$HOME/.dotfiles"

  if [[ -L "$target" ]]
  then
    local current_src
    current_src="$(readlink "$target")"
    if [[ "$current_src" == "$DOTFILES_ROOT" ]]
    then
      return
    fi
  fi

  if [[ -e "$target" && ! -L "$target" ]]
  then
    info "$target exists and is not a symlink; leaving it unchanged"
    return
  fi

  rm -f "$target"
  ln -s "$DOTFILES_ROOT" "$target"
  success "linked $target to $DOTFILES_ROOT"
}


link_file () {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [[ -e "$dst" || -L "$dst" ]]
  then

    if [[ "$overwrite_all" == "false" && "$backup_all" == "false" && "$skip_all" == "false" ]]
    then

      local currentSrc=''
      if [[ -L "$dst" ]]
      then
        currentSrc="$(readlink "$dst")"
      fi

      if [[ "$currentSrc" == "$src" ]]
      then

        skip=true

      else

        user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action

        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            ;;
        esac

      fi

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [[ "$overwrite" == "true" ]]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [[ "$backup" == "true" ]]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [[ "$skip" == "true" ]]
    then
      success "skipped $src"
    fi
  fi

  if [[ "$skip" != "true" ]]
  then
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    success "linked $src to $dst"
  fi
}

install_home_dotfiles () {
  info 'installing top-level dotfiles'

  find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -name 'gitconfig.local.symlink' -not -path '*.git*' -print0 | while IFS= read -r -d '' src
  do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done
}

install_xdg_config () {
  info 'installing XDG config'

  find -H "$DOTFILES_ROOT" -mindepth 3 -maxdepth 3 -path '*/config/*' -not -path '*.git*' -print0 | while IFS= read -r -d '' src
  do
    local rel_path
    rel_path="${src#"$DOTFILES_ROOT"/}"
    rel_path="${rel_path#*/config/}"
    dst="$HOME/.config/$rel_path"
    link_file "$src" "$dst"
  done
}

setup_dotfiles_alias
setup_gitconfig
setup_local_files
install_home_dotfiles
install_xdg_config

echo ''
echo '  All installed!'
