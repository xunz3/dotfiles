# Extract one archive into the current directory while preserving the source.
if [[ $# -ne 1 || -z "$1" ]]; then
  echo 'usage: extract <archive>' >&2
  return 2
fi

local archive=$1
if [[ ! -f "$archive" ]]; then
  echo "not a file: $archive" >&2
  return 1
fi

case "$archive" in
  *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.tar.zst)
    command tar -xf "$archive"
    ;;
  *.zip|*.ZIP)
    command unzip -- "$archive"
    ;;
  *.gz)
    command gzip --decompress --keep -- "$archive"
    ;;
  *.bz2)
    command bzip2 --decompress --keep -- "$archive"
    ;;
  *.xz)
    command xz --decompress --keep -- "$archive"
    ;;
  *.zst)
    command zstd --decompress --keep -- "$archive"
    ;;
  *.7z)
    command 7z x -- "$archive"
    ;;
  *.rar)
    command unrar x -- "$archive"
    ;;
  *.pax)
    command pax -rf "$archive"
    ;;
  *)
    echo "unsupported archive: $archive" >&2
    return 1
    ;;
esac
