#!/bin/sh
#
# Quick recursive text search with a portable fallback.
#
set -eu

if [ "$#" -eq 0 ]; then
	echo 'usage: search <pattern> [path ...]' >&2
	exit 2
fi

if command -v rg >/dev/null 2>&1; then
	exec rg --smart-case "$@"
fi

case "$1" in
  *[[:upper:]]*) exec grep -RIn --exclude-dir=.git -- "$@" ;;
  *) exec grep -RIin --exclude-dir=.git -- "$@" ;;
esac
