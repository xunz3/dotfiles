#!/bin/sh
#
# Show the diffstat of everything you haven't pushed yet.

set -eu

upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || {
  echo "git-unpushed-stat: the current branch has no upstream" >&2
  exit 1
}
count=$(git rev-list --count "$upstream"..HEAD)

if [ "$count" -eq "1" ]
then
  s=''
else
  s='s'
fi

git diff --stat "$upstream"..HEAD
printf ' %s commit%s total\n' "$count" "$s"
