#!/bin/sh
#
# Copy the current branch name to the clipboard.

set -eu

branch=$(git branch --show-current)
if [ -z "$branch" ]; then
  echo "git-copy-branch-name: HEAD is detached" >&2
  exit 1
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
printf '%s\n' "$branch"
printf '%s' "$branch" | "$script_dir/clipboard-copy"
