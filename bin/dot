#!/usr/bin/env bash
#
# dot
#
# `dot` is the main entry point for this dotfiles repository.

set -euo pipefail

parent_directory="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P)"
dotfiles_directory="$(cd "$( dirname "$parent_directory" )" && pwd -P)"

display_usage_and_exit() {
	local exit_code="${1:-0}"

	cat <<'EOF'
dot -- dotfiles management

Usage:
	dot <command> [options]

Commands:
	init        Open the interactive guided setup
	setup       Bootstrap, then run install
	bootstrap   Symlink dotfiles into $HOME
	install     Install packages and run topic installers
	packages    Print the resolved package list for this machine
	ssh         Initialize ~/.ssh permissions and baseline config
	toolchains  Install or inspect the toolchain profile
	update      Pull latest changes, reconcile links, then run install
	edit        Open the dotfiles directory in $EDITOR
	help        Show this help message

Common options:
	init --dry-run        Review choices without running setup
	setup --tui [--user]  Open the guided setup, optionally preselect user-only
	setup --backup       Back up conflicting dotfiles during bootstrap
	setup --user         Skip system package installation
	setup --cache-workspace DIR
	                     Configure centralized caches under DIR/cache
	install --user       Skip system package installation
	install --cache-workspace DIR
	                     Configure caches without running bootstrap
	install --toolchains [profiles] Include selected toolchain profiles
	packages --toolchains [profiles] Print selected toolchain package lists
	toolchains list       Print available toolchain profiles
	toolchains node java  Install selected toolchain profiles
EOF
	exit "$exit_code"
}

require_editor() {
	if [[ -n "${EDITOR:-}" ]]; then
		return 0
	fi

	if command -v code >/dev/null 2>&1; then
		export EDITOR=code
	elif command -v vim >/dev/null 2>&1; then
		export EDITOR=vim
	elif command -v vi >/dev/null 2>&1; then
		export EDITOR=vi
	else
		echo "No editor found. Set EDITOR first." >&2
		exit 1
	fi
}

run_bootstrap() {
	"$dotfiles_directory/script/bootstrap" "$@"
}

run_install() {
	"$dotfiles_directory/script/install" "$@"
}

run_init() {
	exec "$dotfiles_directory/script/setup-tui.sh" "$@"
}

run_setup() {
	local bootstrap_args=()
	local install_args=()
	local passthrough_toolchain_profiles=false
	local use_tui=false
	local argument
	local tui_args=()

	for argument in "$@"
	do
		case "$argument" in
			--tui|--interactive)
				use_tui=true
				;;
			*)
				tui_args+=("$argument")
				;;
		esac
	done
	[[ "$use_tui" == "true" ]] && run_init "${tui_args[@]}"

	while [[ $# -gt 0 ]]
	do
		case "$1" in
			-b|--backup|-f|--force|-s|--skip|--skip-gitconfig)
				bootstrap_args+=("$1")
				;;
			--force-path)
				if [[ $# -lt 2 || -z "${2:-}" || "$2" != /* ]]
				then
					echo "--force-path requires an absolute managed target path" >&2
					exit 1
				fi
				bootstrap_args+=("$1" "$2")
				shift
				;;
			--cache-workspace)
				if [[ $# -lt 2 || -z "${2:-}" || "$2" != /* ]]
				then
					echo "--cache-workspace requires an absolute WORKSPACE path" >&2
					exit 1
				fi
				bootstrap_args+=("$1" "$2")
				shift
				;;
			--user|--toolchains)
				install_args+=("$1")
				[[ "$1" == "--toolchains" ]] && passthrough_toolchain_profiles=true
				;;
			-h|--help)
				display_usage_and_exit
				;;
			*)
				if [[ "$passthrough_toolchain_profiles" == "true" && "$1" != -* ]]
				then
					install_args+=("$1")
				else
					echo "Unknown setup option: $1" >&2
					exit 1
				fi
				;;
		esac
		shift
	done

	run_bootstrap "${bootstrap_args[@]}"
	run_install "${install_args[@]}"
}

run_toolchains() {
	local install_args=(--toolchains)
	local profiles=()

	while [[ $# -gt 0 ]]
	do
		case "$1" in
			list)
				"$dotfiles_directory/toolchains/install.sh" list
				return
				;;
			--user)
				install_args+=(--user)
				;;
			-h|--help)
				display_usage_and_exit
				;;
			*)
				profiles+=("$1")
				;;
		esac
		shift
	done

	run_install "${install_args[@]}" "${profiles[@]}"
}

run_ssh() {
	"$dotfiles_directory/ssh/install.sh" "$@"
}

pull_latest() {
	echo "› git pull"
	git -C "$dotfiles_directory" pull --ff-only
}

command_name="${1:-setup}"
if [[ $# -gt 0 ]]; then
	shift
fi

case "$command_name" in
	init)
		run_init "$@"
		;;
	setup)
		run_setup "$@"
		;;
	bootstrap)
		run_bootstrap "$@"
		;;
	install)
		run_install "$@"
		;;
	packages)
		run_install --print "$@"
		;;
	ssh)
		run_ssh "$@"
		;;
	toolchains)
		run_toolchains "$@"
		;;
	update)
		pull_latest
		run_bootstrap --skip --skip-gitconfig
		run_install "$@"
		;;
	edit)
		require_editor
		exec "$EDITOR" "$dotfiles_directory"
		;;
	help|-h|--help)
		display_usage_and_exit
		;;
	*)
		echo "Unknown command: $command_name" >&2
		display_usage_and_exit 1
		;;
esac
