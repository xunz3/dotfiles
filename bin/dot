#!/usr/bin/env bash
#
# dot
#
# `dot` is the main entry point for this dotfiles repository.

set -euo pipefail

parent_directory="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P)"
dotfiles_directory="$(cd "$( dirname "$parent_directory" )" && pwd -P)"

display_usage_and_exit() {
	local exit_code="${1:-0}"

	cat <<'EOF'
dot -- dotfiles management

Usage:
	dot <command>

Commands:
	setup       Run bootstrap then install packages
	setup-safe  Back up conflicting dotfiles, then install packages
	bootstrap   Symlink dotfiles into $HOME
	install     Install packages and run topic installers
	packages    Print the resolved package list for this machine
	ssh         Initialize ~/.ssh permissions and baseline config
	toolchains  Install toolchain packages, language tools, and optional runtimes
	toolchains-packages Print the toolchain package list for this machine
	toolchains-runtimes Run only optional runtime installers
	update      Pull latest changes then run install
	edit        Open the dotfiles directory in $EDITOR
	help        Show this help message
EOF
	exit "$exit_code"
}

require_editor() {
	if [[ -n "${EDITOR:-}" ]]; then
		return 0
	fi

	if command -v code >/dev/null 2>&1; then
		export EDITOR=code
	elif command -v nvim >/dev/null 2>&1; then
		export EDITOR=nvim
	elif command -v vim >/dev/null 2>&1; then
		export EDITOR=vim
	else
		echo "No editor found. Set EDITOR first." >&2
		exit 1
	fi
}

run_bootstrap() {
	"$dotfiles_directory/script/bootstrap" "$@"
}

run_install() {
	"$dotfiles_directory/script/install" "$@"
}

run_toolchains() {
	run_install --toolchains "$@"
}

run_toolchains_packages() {
	run_install --print --toolchains "$@"
}

run_toolchains_runtimes() {
	DOTFILES_INSTALL_TOOLCHAINS=1 "$dotfiles_directory/toolchains/install.sh" "$@"
}

run_ssh() {
	"$dotfiles_directory/ssh/install.sh" "$@"
}

pull_latest() {
	echo "› git pull"
	git -C "$dotfiles_directory" pull --ff-only
}

command_name="${1:-setup}"
if [[ $# -gt 0 ]]; then
	shift
fi

case "$command_name" in
	setup)
		run_bootstrap "$@"
		run_install
		;;
	setup-safe)
		run_bootstrap --backup "$@"
		run_install
		;;
	bootstrap)
		run_bootstrap "$@"
		;;
	install)
		run_install "$@"
		;;
	packages)
		run_install --print "$@"
		;;
	ssh)
		run_ssh "$@"
		;;
	toolchains)
		run_toolchains "$@"
		;;
	toolchains-packages)
		run_toolchains_packages "$@"
		;;
	toolchains-runtimes)
		run_toolchains_runtimes "$@"
		;;
	update)
		pull_latest
		run_install
		;;
	edit)
		require_editor
		exec "$EDITOR" "$dotfiles_directory"
		;;
	help|-h|--help)
		display_usage_and_exit
		;;
	*)
		echo "Unknown command: $command_name" >&2
		display_usage_and_exit 1
		;;
esac
