# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[alias]
        co = checkout
        sw = switch
        rs = restore
        br = branch
        ci = commit
        st = status
        unstage = restore --staged --
        last = log -1 HEAD
        promote = !$HOME/.dotfiles/bin/git-promote
        wtf     = !$HOME/.dotfiles/bin/git-wtf
        rank-contributors = !$HOME/.dotfiles/bin/git-rank-contributors
        count   = !git shortlog -sn
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        excludesfile = ~/.gitignore
        editor = vim
        pager = $HOME/.dotfiles/bin/git-pager
[interactive]
        diffFilter = $HOME/.dotfiles/bin/git-pager --color-only
[delta]
        navigate = true
[apply]
        whitespace = warn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = prompt
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to suppress warning message
        default = simple
        autoSetupRemote = true
[pull]
        ff = only
[fetch]
        prune = true
[rebase]
        autoStash = true
[rerere]
        enabled = true
[column]
        ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[diff]
        algorithm = histogram
        colorMoved = default
[merge]
        conflictStyle = zdiff3
[commit]
        verbose = true
[init]
	defaultBranch = main
